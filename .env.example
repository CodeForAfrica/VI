# Copy to .env and fill in. .env is gitignored - never commit real secrets.
#
# Only the "Local classifier test" block below is needed to run `make test`
# (docker-compose.classifier.yml substitutes those into the container). The
# other blocks document every variable the code reads for the web app / Lambda /
# other deployments; they have safe defaults and can be left unset locally.

# ─────────────────────────────────────────────────────────────────────────────
# Local classifier test (required for `make test`)
# ─────────────────────────────────────────────────────────────────────────────

# Read-only S3 access to the models bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MODELS_BUCKET=cfa-vulnerability-index-sandbox-models

# Groq arbitration path. Must be a currently-valid key and a live model id -
# a bad key or decommissioned model is caught up front by `check_groq`.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# ─────────────────────────────────────────────────────────────────────────────
# Optional overrides (sensible defaults if unset)
# ─────────────────────────────────────────────────────────────────────────────

# Needed only for temporary/role-based AWS creds (e.g. a Lambda execution role).
# Leave blank for long-term IAM user keys.
AWS_SESSION_TOKEN=
AWS_S3_REGION_NAME=eu-west-1

# Where models are cached on disk. The classifier compose sets this to /models
# (a mounted volume); set it only if running outside that compose.
MODEL_CACHE_DIR=
# Optional pre-extracted model archive dirs (default to the cache above).
LOCAL_MODELS_DIR=
BASE_MODELS_DIR=

# Silence tqdm progress bars in container logs.
TQDM_DISABLE=

# ─────────────────────────────────────────────────────────────────────────────
# Web app / other deployments (NOT needed for the local classifier test -
# docker-compose.classifier.yml sets the DB + secret key itself)
# ─────────────────────────────────────────────────────────────────────────────

# Database. DB_HOST has NO prod default - it must be set per environment.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Django.
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, MUST include the scheme, e.g. http://localhost,http://example.com
CSRF_TRUSTED_ORIGINS=http://localhost

# Redis cache/sessions.
REDIS_URL=redis://127.0.0.1:6379/1

# Ingestion (Lambda / management commands).
MEDIACLOUD_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Inference API - the vi-model-inference service (config.inference_wsgi)
# ─────────────────────────────────────────────────────────────────────────────

# Accepted API keys as a JSON list of {caller, key} (from Secrets Manager in
# prod). Empty = every inference request is rejected with 401.
# e.g. [{"caller":"vi-lambda-prod","key":"<32+ random bytes>"}]
VI_INFERENCE_ACCEPTED_KEYS=
# Per-caller requests/minute (in-process counter; resets on restart).
VI_RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Version string reported in /readyz and every successful response.
MODEL_VERSION=2026-09-04
# Request limits. Body bytes and article-text chars before tokenization.
VI_MAX_BODY_BYTES=262144
VI_MAX_TEXT_CHARS=200000
# Concurrent inferences allowed (single loaded ensemble -> keep at 1).
VI_MAX_CONCURRENT_INFERENCE=1
# Set by config.inference_wsgi itself; do not set by hand for the web app.
# ROOT_URLCONF=inference_api.urls

# ─────────────────────────────────────────────────────────────────────────────
# Inference client - how the ingestion Lambda reaches the API above
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the inference API. If unset (or the key is unset) the Lambda
# still ingests but skips classification. Never hardcode this in code.
VI_INFERENCE_API_URL=
# The Lambda's X-API-Key value (must match one entry in VI_INFERENCE_ACCEPTED_KEYS).
VI_INFERENCE_API_KEY=
# Per-request timeout (s), retry attempts, and max articles classified per run.
VI_INFERENCE_TIMEOUT=180
VI_INFERENCE_MAX_ATTEMPTS=3
VI_INFERENCE_MAX_PER_RUN=200

# Optional GitHub token used by some tooling.
GITHUB_TOKEN=
