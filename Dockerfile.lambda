FROM public.ecr.aws/lambda/python:3.12

# System dependencies (Amazon Linux 2023 uses dnf, not apt-get)
RUN dnf install -y gcc gcc-c++ postgresql-devel cairo-devel pkg-config && dnf clean all

RUN pip install --upgrade pip setuptools wheel

# Ingestion-only dependencies. The heavy ML stack (torch, transformers, etc.) is
# intentionally NOT installed here - classification moved to the classifier
# container. This is what keeps the image well under Lambda's 10GB limit.
COPY requirements-lambda.txt .
RUN pip install --no-cache-dir -r requirements-lambda.txt

# Copy only what Lambda needs
COPY lambda_function.py .
COPY dashboard/ ./dashboard/
# config/ holds Django settings (config.settings), which the ingestion service
# loads via django.conf.settings, so this must be present.
COPY config/ ./config/

CMD ["lambda_function.lambda_handler"]
